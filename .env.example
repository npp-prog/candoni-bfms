# Copy to .env.local for local development. In Netlify, set these per deploy context.
# Firebase web config is public (security = Rules + Functions) but differs per environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=candoni-bfms-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=candoni-bfms-dev
VITE_FIREBASE_STORAGE_BUCKET=candoni-bfms-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=asia-southeast1
VITE_APP_ENV=dev
# true = connect to local emulators (auth 9099, firestore 8080, functions 5001, storage 9199)
VITE_USE_EMULATORS=true
